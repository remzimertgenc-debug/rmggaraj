# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Authorized Marketplace Price Provider (Backend Only - Never expose in VITE_ vars)
# Optional: Set when connecting an authorized Sahibinden/Letgo/Marketplace data partner API
PRICE_API_BASE_URL=""
PRICE_API_KEY=""
