{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/|api$).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/[...route].ts": {
      "includeFiles": "{firebase-applet-config.json,server/data/userListings.json}",
      "maxDuration": 10
    }
  }
}
