# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Authorized Marketplace Price Provider (Backend Only - Never expose in VITE_ vars)
# Optional: Set when connecting an authorized Sahibinden/Letgo/Marketplace data partner API
PRICE_API_BASE_URL=""
PRICE_API_KEY=""

# Optional Store Affiliate XML/JSON Feed URLs (Backend Only)
VATAN_FEED_URL=""
ITOPYA_FEED_URL=""
SINERJI_FEED_URL=""
TRENDYOL_FEED_URL=""
STORE_FEED_URLS=""

# Optional Frontend Bot Protection (Invisible Cloudflare Turnstile / reCAPTCHA v3)
VITE_TURNSTILE_SITE_KEY=""
VITE_RECAPTCHA_SITE_KEY=""

# Supabase / Prisma PostgreSQL Connection Strings
DATABASE_URL=""
DIRECT_URL=""
